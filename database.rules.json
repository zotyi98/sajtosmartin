{
  "rules": {
    ".read": false,
    ".write": false,

    "leaderboard": {
      ".read": true,
      "$name": {
        ".read": true,
        ".write": "!newData.exists() || (newData.hasChild('_session') && newData.child('_session').val() === root.child('sessions').child($name).val())",
        ".validate": "!newData.exists() || newData.hasChildren(['displayName', 'bps', 'lastSaved'])"
      }
    },

    "sessions": {
      "$name": {
        ".read": false,
        ".write": true
      }
    },

    "accounts": {
      "$name": {
        ".read": true,
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['passwordHash', 'salt', 'createdAt'])"
      }
    },

    "users": {
      "$name": {
        "game": {
          ".read": true,
          ".write": "!newData.exists() || (newData.hasChild('_session') && newData.child('_session').val() === root.child('sessions').child($name).val())",
          ".validate": "!newData.exists() || (!newData.hasChild('password') && !newData.hasChild('passwordHash'))"
        },
        "password": {
          ".read": true,
          ".write": false
        },
        ".read": true
      }
    },

    "config": {
      "admins": {
        "$name": {
          ".read": true,
          ".write": false
        }
      }
    },

    "admin": {
      "reset": {
        ".read": true,
        ".write": true
      },
      "updateSignal": {
        ".read": true,
        ".write": true
      }
    },

    "activity": {
      ".read": true,
      "$id": {
        ".write": "!data.exists()",
        ".validate": "newData.hasChildren(['displayName', 'type', 'msg', 'at']) && newData.child('at').isNumber()"
      }
    },

    "duels": {
      ".read": true,
      "$duelId": {
        ".write": true,
        ".validate": "!newData.exists() || (newData.hasChildren(['challengerKey', 'targetKey', 'stake', 'status']) && newData.child('stake').val() >= 5000 && newData.child('stake').val() <= 2000000)"
      }
    },

    "trioRooms": {
      ".read": true,
      "$roomId": {
        ".write": true
      }
    },

    "reports": {
      "cheatLogs": {
        "$logId": {
          ".read": true,
          ".write": true,
          ".validate": "newData.hasChildren(['user', 'reason', 'timestamp'])"
        }
      }
    }
  }
}
